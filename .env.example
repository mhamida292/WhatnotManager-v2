# Copy to `.env` (same directory as docker-compose.yml) and fill in a real value.
# `.env` is gitignored; this example file is not.

# Signs session cookies. REQUIRED -- docker compose will refuse to start without it.
# Generate one with:  openssl rand -hex 32
# Changing this value invalidates every existing session (everyone logs in again).
APP_SECRET=

# Optional. Where users.db and ws/<userId>.db live. Compose already sets this to
# /app/data inside the container; only override for a non-Docker run.
# DATA_DIR=./data
